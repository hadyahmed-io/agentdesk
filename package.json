{
  "name": "agentdesk",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first AI coding agent management and development workflow platform",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev --workspace=@agentdesk/api\" \"npm run dev --workspace=@agentdesk/web\"",
    "build": "npm run build --workspace=@agentdesk/api && npm run build --workspace=@agentdesk/web",
    "start": "npm run start --workspace=@agentdesk/api",
    "typecheck": "npm run typecheck --workspace=@agentdesk/api && npm run typecheck --workspace=@agentdesk/web",
    "lint": "eslint \"apps/*/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run && vitest run --config vitest.web.config.ts",
    "test:unit": "vitest run apps/api/src/**/*.test.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate --workspace=@agentdesk/api",
    "db:seed": "npm run db:seed --workspace=@agentdesk/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.2",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
