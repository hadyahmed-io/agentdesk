# AgentDesk Configuration (.env.example)
# Copy this file to .env to customize local settings.
# Never commit real API keys or secrets to version control.

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Frontend Origin (for narrow CORS policy in development)
CORS_ORIGIN=http://localhost:5173

# SQLite Database Path (relative to apps/api or absolute path)
DATABASE_URL=./data/agentdesk.sqlite

# Default Approved Workspace Root for Local Agent Execution
# Local CLI providers can only execute within this approved directory tree.
# Defaults automatically to the repository root directory if omitted.
# APPROVED_WORKSPACE_ROOT=/path/to/your/workspaces

# Execution Safety Controls
DEFAULT_EXECUTION_TIMEOUT_MS=240000
MAX_LOG_PAYLOAD_BYTES=65536

# Optional Local CLI Agent Configuration (leave blank if only using Demo Provider)
LOCAL_AGENT_CLI_BINARY=
LOCAL_AGENT_CLI_TIMEOUT_MS=120000
